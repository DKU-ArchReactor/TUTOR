{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Independent TUTOR registry and test-image builder; no BE image or environment permissions.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "SourceBucket": {
      "Type": "String"
    },
    "BuildProjectName": {
      "Type": "String"
    },
    "RepositoryName": {
      "Type": "String"
    }
  },
  "Resources": {
    "Repository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "TUTOR image versions independent from BE; retain tagged releases for explicit rollback",
          "must": [
            "Never use the BE repository",
            "Never expire tagged rollback images automatically"
          ]
        }
      },
      "Properties": {
        "RepositoryName": {
          "Ref": "RepositoryName"
        },
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Remove only untagged images after 14 days\",\"selection\":{\"tagStatus\":\"untagged\",\"countType\":\"sinceImagePushed\",\"countUnit\":\"days\",\"countNumber\":14},\"action\":{\"type\":\"expire\"}}]}"
        }
      }
    },
    "BuildLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/codebuild/${AWS::StackName}"
        },
        "RetentionInDays": 14
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Independent TUTOR BuildLogs lifecycle",
          "must": [
            "Deploy only to the explicitly configured account and region",
            "Keep BE and CORE unchanged"
          ]
        }
      }
    },
    "BuildRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "isolated image builder with only TUTOR registry and source prefix access",
          "must": [
            "No permission to rebuild or deploy BE"
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codebuild.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:codebuild:${AWS::Region}:${AWS::AccountId}:project/${BuildProjectName}"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "tutor-build",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Repository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SourceBucket}/tutor-source/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetBucketLocation",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SourceBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "BuildLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Builder": {
      "Type": "AWS::CodeBuild::Project",
      "Properties": {
        "Name": {
          "Ref": "BuildProjectName"
        },
        "ServiceRole": {
          "Fn::GetAtt": [
            "BuildRole",
            "Arn"
          ]
        },
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Source": {
          "Type": "S3",
          "Location": {
            "Fn::Sub": "${SourceBucket}/tutor-source/initial.zip"
          },
          "BuildSpec": "infrastructure/buildspec.yml"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/standard:7.0",
          "PrivilegedMode": true,
          "EnvironmentVariables": [
            {
              "Name": "REPOSITORY_URI",
              "Value": {
                "Fn::GetAtt": [
                  "Repository",
                  "RepositoryUri"
                ]
              }
            }
          ]
        },
        "TimeoutInMinutes": 20,
        "QueuedTimeoutInMinutes": 30,
        "LogsConfig": {
          "CloudWatchLogs": {
            "Status": "ENABLED",
            "GroupName": {
              "Ref": "BuildLogs"
            }
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Independent TUTOR Builder lifecycle",
          "must": [
            "Deploy only to the explicitly configured account and region",
            "Keep BE and CORE unchanged"
          ]
        }
      }
    }
  },
  "Outputs": {
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "RepositoryUri"
        ]
      },
      "Description": "Independent TUTOR image repository"
    },
    "BuildProject": {
      "Value": {
        "Ref": "Builder"
      },
      "Description": "TUTOR-only test and image builder"
    }
  }
}
