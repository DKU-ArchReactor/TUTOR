{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TUTOR gRPC on Fargate with private service discovery, BE-only ingress and independent image rollbacks.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "BackendSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "Image": {
      "Type": "String",
      "AllowedPattern": "[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[a-f0-9]{64}"
    },
    "NamespaceId": {
      "Type": "String",
      "AllowedPattern": "ns-[a-z0-9]+"
    },
    "ServiceName": {
      "Type": "String"
    },
    "RepositoryName": {
      "Type": "String"
    },
    "NamespaceName": {
      "Type": "String"
    }
  },
  "Resources": {
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": {
          "Ref": "ServiceName"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Independent TUTOR Cluster lifecycle",
          "must": [
            "Deploy only to the explicitly configured account and region",
            "Keep BE and CORE unchanged"
          ]
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/ecs/${ServiceName}"
        },
        "RetentionInDays": 14
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Independent TUTOR Logs lifecycle",
          "must": [
            "Deploy only to the explicitly configured account and region",
            "Keep BE and CORE unchanged"
          ]
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "allow direct HTTP2 gRPC only from existing BE instances; outbound HTTPS permits ECR and logs without NAT",
          "must": [
            "Never open ingress to internet",
            "Keep separate from BE and database security groups"
          ]
        }
      },
      "Properties": {
        "GroupDescription": "TUTOR gRPC from backend only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 50051,
            "ToPort": 50051,
            "SourceSecurityGroupId": {
              "Ref": "BackendSecurityGroup"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "Discovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "tutor",
        "NamespaceId": {
          "Ref": "NamespaceId"
        },
        "DnsConfig": {
          "RoutingPolicy": "MULTIVALUE",
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            }
          ]
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Independent TUTOR Discovery lifecycle",
          "must": [
            "Deploy only to the explicitly configured account and region",
            "Keep BE and CORE unchanged"
          ]
        }
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Fargate image pulls and logs; TUTOR sample has no AWS API role or secrets",
          "must": [
            "Allow pulls only from the TUTOR repository"
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "tutor-runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/${RepositoryName}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "bounded sample service; immutable digest allows deterministic rollout and rollback",
          "must": [
            "No model invocation or database access",
            "Non-root process and read-only root filesystem"
          ]
        }
      },
      "Properties": {
        "Family": {
          "Ref": "ServiceName"
        },
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ContainerDefinitions": [
          {
            "Name": "tutor",
            "Image": {
              "Ref": "Image"
            },
            "Essential": true,
            "User": "10001",
            "ReadonlyRootFilesystem": true,
            "LinuxParameters": {
              "InitProcessEnabled": true,
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            },
            "PortMappings": [
              {
                "ContainerPort": 50051,
                "Protocol": "tcp",
                "AppProtocol": "grpc"
              }
            ],
            "StopTimeout": 30,
            "HealthCheck": {
              "Command": [
                "CMD",
                "python",
                "-m",
                "service.healthcheck"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 20
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "tutor",
                "mode": "non-blocking",
                "max-buffer-size": "1m"
              }
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "no load balancer or NAT fixed charge for demo; DNS advertises only private task IPs",
          "must": [
            "Public IP is outbound-only via SG",
            "Do not modify BE or CORE resources",
            "Keep desired count at least one"
          ]
        }
      },
      "Properties": {
        "ServiceName": {
          "Ref": "ServiceName"
        },
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "Task"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DesiredCount": 1,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "SubnetId"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "SecurityGroup"
              }
            ]
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "Discovery",
                "Arn"
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "GrpcTarget": {
      "Description": "BE TUTOR_GRPC_TARGET; private VPC DNS only",
      "Value": {
        "Fn::Sub": "tutor.${NamespaceName}:50051"
      }
    },
    "TaskDefinition": {
      "Description": "Current independent TUTOR revision",
      "Value": {
        "Ref": "Task"
      }
    },
    "CoreSecurityGroup": {
      "Description": "BE-only ingress group",
      "Value": {
        "Ref": "SecurityGroup"
      }
    }
  }
}
